# ---------------------------------------------------------------------------
# Production frontend environment — TEMPLATE. Every value is empty on purpose.
#
# WHAT THIS FILE IS FOR
# ---------------------------------------------------------------------------
# It documents which variables a production build needs. It is NOT the file the
# build reads: on a static host these are set in the host's own environment
# (Netlify → Site settings → Environment variables; Vercel → Project Settings →
# Environment Variables; Cloudflare Pages → Settings → Environment variables),
# per deploy context, so that production and preview builds differ without a
# file being edited.
#
# `.env.production` is git-ignored. If you create one locally, it stays local.
#
# ---------------------------------------------------------------------------
# EVERYTHING HERE SHIPS INSIDE THE BROWSER BUNDLE
# ---------------------------------------------------------------------------
# Vite inlines every VITE_* variable at BUILD time. Anyone can read them by
# opening the bundle. Never put a secret in this file or in any VITE_* variable.
#
# The real secrets are Apps Script Script Properties and live only there:
#   SESSION_HMAC_SECRET, PASSWORD_PEPPER,
#   DRIVE_ROOT_FOLDER_ID, TRACKING_SPREADSHEET_ID
# Generate the first two with `npm run secrets:generate`. See DEPLOYMENT.md §5.
#
# `npm run verify:build` fails the build if any of those names appears in
# `dist/`, so this boundary is checked rather than merely stated.
# ---------------------------------------------------------------------------

# The PRODUCTION Apps Script Web App URL, ending in /exec.
#
# Not a secret — the security boundary is the session token plus the per-action
# authorization check, not the URL (DEPLOYMENT.md §2.3). It IS
# environment-specific: a production build carrying the development endpoint
# writes the company's real quotations into the development spreadsheet, and
# burns numbers out of the development counter.
#
# Take it from: Apps Script → Deploy → Manage deployments → the PRODUCTION
# deployment → Web app URL. Confirm it is the production one, not development,
# before pasting it into the host.
VITE_GAS_ENDPOINT=

# "production" for the live site. Gates the development-only affordances.
VITE_APP_ENV=

# The company's VAT registration number — 15 digits, first and last both 3.
#
# LEAVE THIS EMPTY IN PRODUCTION. Empty means the application uses the
# company's real registered number from `src/config/env.ts`, and the backend's
# COMPANY_VAT_NUMBER Script Property remains authoritative for what is printed
# on a generated document.
#
# Set it only to OVERRIDE, which in practice means only on a test deployment
# that must not print the live registration.
VITE_COMPANY_VAT_NUMBER=
