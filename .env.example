# ---------------------------------------------------------------------------
# Frontend environment. Copy to `.env.local` and fill in.
#
# Everything here ships inside the browser bundle and is therefore PUBLIC.
# Never put a secret in this file or in any VITE_* variable.
#
# All real secrets live in Google Apps Script Script Properties:
#   SESSION_HMAC_SECRET, PASSWORD_PEPPER, DRIVE_ROOT_FOLDER_ID,
#   TRACKING_SPREADSHEET_ID, ALLOWED_ORIGINS,
#   COMPANY_CODE, BRANCH_CODE, DOC_TYPE_CODE, COMPANY_VAT_NUMBER
# See IMPLEMENTATION_PLAN.md §22 and google-apps-script/README.md.
# ---------------------------------------------------------------------------

# Deployed Google Apps Script Web App URL, ending in /exec.
# Not a secret: the security boundary is the session token, not this URL.
VITE_GAS_ENDPOINT=

# "development" | "production"
VITE_APP_ENV=development

# The company's VAT registration number — 15 digits, first and last both 3.
#
# OPTIONAL. Leave it blank to use the value configured in src/config/env.ts,
# which is the company's real number. Set it only to override, for example on a
# test deployment that must not print the live registration.
#
# It appears on the quotation and resolves {{company.vatNumber}} in a term, so
# it is public by definition — never a secret. The backend holds the same value
# as the COMPANY_VAT_NUMBER Script Property and is authoritative for generated
# documents; this copy only feeds the on-screen preview.
VITE_COMPANY_VAT_NUMBER=
